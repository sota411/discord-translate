# Discord credentials and allowlists
# Keep secret and ID fields empty in this tracked example.
# Use comma-separated decimal IDs. ALLOWED_USER_IDS must include every speaker.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
ALLOWED_GUILD_IDS=
ALLOWED_USER_IDS=

# Soniox project
SONIOX_API_KEY=
# us, eu, or jp. It must match the API key's Project region.
SONIOX_REGION=us

# Session limits
SESSION_MAX_MINUTES=120
# Supported range: 1 to 3 concurrent human speakers.
MAX_SPEAKERS_PER_SESSION=2
SESSION_IDLE_TIMEOUT_SECONDS=120
# Legacy name retained for existing deployments. Backlog no longer stops a session.
PLAYBACK_QUEUE_MAX_MS=10000
UTTERANCE_MAX_SOURCE_SECONDS=30
TTS_MAX_INPUT_CHARACTERS=300
VOICE_RECONNECT_TIMEOUT_MS=5000
SONIOX_TERMINATION_TIMEOUT_MS=5000

# Monthly budgets in micro-USD. Decide these from the operator's budget.
USER_MONTHLY_COST_LIMIT_MICROUSD=1000000
GUILD_MONTHLY_COST_LIMIT_MICROUSD=3000000
GLOBAL_MONTHLY_COST_LIMIT_MICROUSD=4000000
# Mirror the Project monthly budget configured in Soniox Console in micro-USD.
# Example: USD 5 = 5000000 micro-USD.
# It must be greater than GLOBAL_MONTHLY_COST_LIMIT_MICROUSD.
SONIOX_PROJECT_MONTHLY_BUDGET_MICROUSD=5000000

# Pricing and reconciliation
# Confirmed at https://soniox.com/pricing on 2026-08-22.
# Audio components: realtime STT input is USD 0.06/hour and realtime TTS output
# is USD 0.645/hour. Text is USD 4/1M tokens at about 0.3 token/character.
STT_COST_MICROUSD_PER_HOUR=60000
TTS_COST_MICROUSD_PER_HOUR=645000
# Legacy variable name retained. The distributed value is the official
# USD 1.20/1M-character approximation before applying the safety percentage.
TEXT_COST_MICROUSD_PER_MILLION_CHARACTERS_UPPER_BOUND=1200000
COST_ESTIMATE_SAFETY_PERCENT=125
PRICING_CONFIRMED_AT=2026-08-22
PRICING_MAX_AGE_DAYS=30
USAGE_RECONCILE_INTERVAL_SECONDS=60
USAGE_RECONCILE_MAX_STALENESS_SECONDS=180
SONIOX_LIMIT_CHECK_MAX_STALENESS_SECONDS=30

# Soniox models and speaker voice slots
SONIOX_STT_MODEL=stt-rt-v5
# Set true to send fixed conversation hints in context.general and deduplicated
# translation source/target values in recognition context.terms.
# Translation context.translation_terms is sent either way.
SONIOX_GENERAL_CONTEXT_ENABLED=false
SONIOX_TTS_MODEL=tts-rt-v2
# Soniox対応範囲は0.7〜1.3。セッション開始時の速度です。
# 実行中は /translate speed で、そのセッションだけを変更できます。
SONIOX_TTS_SPEED=1.15
# Confirmed against tts-rt-v2 on 2026-08-15. The legacy variable names are
# speaker slots 1, 2, and 3. Every slot must use a different multilingual voice.
SONIOX_VOICE_JA=Kenji
SONIOX_VOICE_KO=Mina
SONIOX_VOICE_EN=Emma

# Local files and pseudonymous logging
# Use a host absolute path. Docker Compose mounts this file read-only at a
# fixed container path. Leave it empty to use an empty terms file.
TRANSLATION_TERMS_PATH=
SQLITE_PATH=/data/usage.sqlite
# Generate a dedicated value with: openssl rand -hex 32
LOG_ID_HMAC_KEY=
