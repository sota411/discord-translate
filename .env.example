# Discord credentials and allowlists
# Keep secret and ID fields empty in this tracked example.
# Use comma-separated decimal IDs. ALLOWED_USER_IDS must include every speaker.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
ALLOWED_GUILD_IDS=
ALLOWED_USER_IDS=

# Soniox project
SONIOX_API_KEY=
# us, eu, or jp. It must match the API key's Project region.
SONIOX_REGION=

# Session limits
SESSION_MAX_MINUTES=30
MAX_SPEAKERS_PER_SESSION=2
SESSION_IDLE_TIMEOUT_SECONDS=
PLAYBACK_QUEUE_MAX_MS=
UTTERANCE_MAX_SOURCE_SECONDS=
TTS_MAX_INPUT_CHARACTERS=
VOICE_RECONNECT_TIMEOUT_MS=
SONIOX_TERMINATION_TIMEOUT_MS=

# Monthly budgets in micro-USD. Decide these from the operator's budget.
USER_MONTHLY_COST_LIMIT_MICROUSD=
GUILD_MONTHLY_COST_LIMIT_MICROUSD=
GLOBAL_MONTHLY_COST_LIMIT_MICROUSD=
# Mirror the Project monthly budget configured in Soniox Console in micro-USD.
# Example: USD 5 = 5000000 micro-USD.
# It must be greater than GLOBAL_MONTHLY_COST_LIMIT_MICROUSD.
SONIOX_PROJECT_MONTHLY_BUDGET_MICROUSD=

# Pricing and reconciliation
STT_COST_MICROUSD_PER_HOUR=120000
TTS_COST_MICROUSD_PER_HOUR=700000
TEXT_COST_MICROUSD_PER_MILLION_CHARACTERS_UPPER_BOUND=
COST_ESTIMATE_SAFETY_PERCENT=
PRICING_CONFIRMED_AT=2026-08-15
PRICING_MAX_AGE_DAYS=
USAGE_RECONCILE_INTERVAL_SECONDS=
USAGE_RECONCILE_MAX_STALENESS_SECONDS=
SONIOX_LIMIT_CHECK_MAX_STALENESS_SECONDS=

# Soniox models and voices
SONIOX_STT_MODEL=stt-rt-v5
SONIOX_TTS_MODEL=tts-rt-v2
SONIOX_VOICE_JA=
SONIOX_VOICE_KO=
SONIOX_VOICE_EN=

# Local files and pseudonymous logging
TRANSLATION_TERMS_PATH=
SQLITE_PATH=/absolute/path/to/discord-translate/.data/usage.sqlite
# Generate a dedicated value with: openssl rand -hex 32
LOG_ID_HMAC_KEY=
