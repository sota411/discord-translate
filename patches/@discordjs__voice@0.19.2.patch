@@ -2117,6 +2117,7 @@ var VoiceReceiver = class {
    * @internal
    */
   onUdpMessage(msg) {
+    const receivedAtMonotonicMs = performance.now();
     if (msg.length <= 8) return;
     const ssrc = msg.readUInt32BE(8);
     const userData = this.ssrcMap.get(ssrc);
@@ -2136,7 +2137,13 @@ var VoiceReceiver = class {
           this.connectionData.secretKey,
           userData.userId
         );
-        if (packet) stream.push(packet);
+        if (packet) {
+          // Keep the existing Buffer stream; opt-in diagnostics receive its RTP clock.
+          if (stream.listenerCount("rtpPacket")) stream.emit("rtpPacket", packet, {
+            sequence: msg.readUInt16BE(2), timestamp: msg.readUInt32BE(4), ssrc, receivedAtMonotonicMs
+          });
+          stream.push(packet);
+        }
       } catch (error) {
         stream.destroy(error);
       }
